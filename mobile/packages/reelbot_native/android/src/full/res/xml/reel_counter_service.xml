<?xml version="1.0" encoding="utf-8"?>
<!-- Starts with this app only. ReelCounterService.applyScope() widens it to Instagram, YouTube, browsers and limited apps once the user has opted in and set something, so a payment or bank app is never seen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews"
    android:packageNames="app.reelbrain"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100"
    android:summary="@string/reelbot_service_summary"
    android:description="@string/reelbot_service_description"/>
