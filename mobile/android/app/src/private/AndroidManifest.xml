<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      Private build: nothing that reads the phone beyond the app's own data. Removed here:
      - the Accessibility service (reads other apps' screens);
      - Usage access (PACKAGE_USAGE_STATS) and the battery-optimisation exemption;
      - the notification permission (the build posts no notifications; see res/values/flags.xml).
      What remains is INTERNET, plus the permissions WorkManager adds for background analysis. Android grants those
      without asking and shows no prompt for them: network state, wake lock, run at boot, short foreground service.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove"/>
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:node="remove"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove"/>
    <application>
        <service android:name="app.reelbrain.ReelCounterService" tools:node="remove"/>
    </application>
</manifest>
