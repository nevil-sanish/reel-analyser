<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      Semi build: nothing that reads the phone beyond the app's own data. The Accessibility service, Usage access, battery
      exemption and installer are not part of this build at all (they live in the plugin's full flavour). The one thing left
      to remove here comes from a dependency: workmanager adds the notification permission, and this build posts no
      notifications. What remains is INTERNET, plus the permissions WorkManager adds for background analysis (network
      state, wake lock, run at boot, short foreground service), which Android grants without a prompt.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove"/>
</manifest>
